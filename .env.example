# 개발자 포털 > Bot > Reset Token
DISCORD_BOT_TOKEN=
# 개발자 포털 > General Information > Application ID
DISCORD_APP_ID=
# 쉼표로 구분한 디스코드 사용자 ID (운영자 포함)
ALLOWED_USER_IDS=
# 개발용만. `npm run gen-key` 출력값. 운영 서버는 systemd credential 사용
MASTER_KEY=
# 선택: 마스터 키 파일 경로
MASTER_KEY_FILE=
DATA_DIR=./data
AI_ENABLED=true
SYNC_INTERVAL_MIN=30
USER_API_DELAY_MS=1200
LOG_LEVEL=info
